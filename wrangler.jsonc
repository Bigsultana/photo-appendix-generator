{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "photo-appendix-generator",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "npm run build",
    "watch_dir": ["index.html"]
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
